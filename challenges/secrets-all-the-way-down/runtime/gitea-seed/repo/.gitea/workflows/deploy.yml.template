name: deploy-to-staging

on:
  push:
    branches: [main]

# NOTE(ops): we kept hitting "credentials not found" when these lived in repo
# secrets, so they are inlined here for now. Clean this up later.
env:
  AWS_DEFAULT_REGION: us-east-1
  AWS_ACCESS_KEY_ID: AKIAI0STAGING0DEPLOYER
  AWS_SECRET_ACCESS_KEY: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY01
  AWS_ENDPOINT_PORT: __LOCALSTACK_PORT__

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Show deploy identity
        # This echo lands in the build log on every run, which is its own
        # problem, but it is also handy for you right now:
        run: |
          echo "deploying as $AWS_ACCESS_KEY_ID"
          echo "stage 2 checkpoint: __FLAG_PIPELINE__"

      - name: Push infra
        run: |
          aws --endpoint-url "http://TEAM_HOST:$AWS_ENDPOINT_PORT" sts get-caller-identity
          echo "applying terraform..."
