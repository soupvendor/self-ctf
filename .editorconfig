root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shfmt reads this file, so it is what keeps shell scripts on spaces
# rather than shfmt's default tabs.
[*.{sh,bash}]
indent_size = 2
binary_next_line = true
switch_case_indent = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
