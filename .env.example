# Copy to .env and fill in, or run `mise run env:init` to do both.
# .env is gitignored and holds the real values.

# --- CTFd platform ---
# Change both together if 8000 is taken (e.g. a second checkout of this repo).
CTFD_PORT=8000
CTFD_URL=http://localhost:8000
CTFD_NAME=self-ctf
CTFD_ADMIN_NAME=ctfadmin
CTFD_ADMIN_EMAIL=ctfadmin@internal.local
CTFD_ADMIN_PASSWORD=

# Generate both: openssl rand -hex 32
CTFD_SECRET_KEY=
CTFD_DB_PASSWORD=

# --- Challenge stack ---
# The host players reach challenge services on. It is supplied separately to
# each team and never baked into a shared player artifact or runtime image.
CHALLENGE_HOST=localhost
GITEA_PORT=3000
LOCALSTACK_PORT=4566
GITEA_SCHEME=http
GITEA_HOST_PREFIX=
LOCALSTACK_SCHEME=http
LOCALSTACK_HOST_PREFIX=

# Intentionally recoverable challenge credentials. The artifact and runtime
# seeder consume the same values so the stage 1 handoff cannot drift.
DEPLOY_USER=deploy-bot
DEPLOY_PASSWORD=D3ploy-B0t-CI-2026!

# Gitea's own admin, so the account players recover is an ordinary user.
# Never handed out; unrelated to CTFD_ADMIN_PASSWORD.
GITEA_ADMIN_PASSWORD=

# --- Flags ---
# One variable per flag, not per challenge: a multi-flag challenge takes
# several, named for the stage.
# Placeholders are not valid answers - `mise run flags:generate` replaces them.
FLAG_LAYERS=flag{EXAMPLE_REPLACE_ME}
FLAG_PIPELINE=flag{EXAMPLE_REPLACE_ME}
FLAG_CLOUD=flag{EXAMPLE_REPLACE_ME}
