# Copy to .env and fill in. .env is gitignored and holds the real values.
# Generate flags with: mise run flags:generate

# --- CTFd instance ---
CTFD_URL=http://localhost:8000
CTFD_NAME=self-ctf
CTFD_ADMIN_NAME=ctfadmin
CTFD_ADMIN_EMAIL=ctfadmin@internal.local
CTFD_ADMIN_PASSWORD=

# --- Flags ---
# One per challenge, named FLAG_<CHALLENGE> in SCREAMING_SNAKE_CASE.
# Placeholders below are not valid answers — mise run flags:generate replaces them.
FLAG_BURIED_IN_THE_LAYERS=flag{EXAMPLE_REPLACE_ME}
