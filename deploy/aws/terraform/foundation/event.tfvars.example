aws_region     = "us-east-1"
aws_account_id = "123456789012"
event_name     = "devops-ctf"

vpc_id             = "vpc-0123456789abcdef0"
private_subnet_ids = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]

# Replace all five IDs with company-managed endpoints in this VPC.
existing_endpoint_ids = {
  "ecr.api"      = "vpce-00000000000000001"
  "ecr.dkr"      = "vpce-00000000000000002"
  logs           = "vpce-00000000000000003"
  secretsmanager = "vpce-00000000000000004"
  s3             = "vpce-00000000000000005"
}

# Set true only to create services omitted above (S3 creation changes subnet routes).
create_missing_endpoints = false

ecr_repository_names = ["ctfd", "mariadb", "redis", "gitea", "gitea-seed", "localstack-seeded"]

tags = {
  Owner = "platform-team"
}
